# Optional server-side configuration. Export variables in your shell; no .env loader is used.
# APP_DB_PATH=/absolute/path/to/lovelab.db
# AI_API_URL=https://your-provider.example/v1/chat/completions
# AI_API_KEY=replace-locally-never-commit
# AI_MODEL=your-model
# Optional local Ollama model. A complete AI_API_* configuration takes priority.
# OLLAMA_MODEL=dolphin-llama3:8b
# OLLAMA_BASE_URL=http://127.0.0.1:11434
